# Server Configuration
PORT=3000

# Living World Configuration (Phase 4)
# Real seconds per world tick (default: 3600 = 1 hour; set low like 10 for demos)
WORLD_TICK_SECONDS=3600
# Maximum ticks that can be applied in a single resume_game call (default: 100)
MAX_TICKS_PER_RESUME=100

# Narration (Amazon Bedrock)
NARRATION_ENABLED=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# AWS credentials (one of these required for Bedrock):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_ROLE_ARN=

# Database
DB_PATH=./data/grimoire.db