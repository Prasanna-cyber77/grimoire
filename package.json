{
  "name": "grimoire",
  "version": "0.1.0",
  "description": "Grimoire MCP Server - A self-hosted MCP server for voice-only tabletop RPG",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa-plus",
    "amazon-bedrock",
    "typescript",
    "rpg",
    "voice-ai",
    "dungeon-master",
    "hackathon"
  ],
  "author": "Prasanna Mate",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.19.2",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^10.11.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
